# 사이트 레포 루트의 절대 경로.
SITE_ROOT=
# 글 폴더와 JSON Schema 파일. SITE_ROOT 기준 경로이고, 비워 두면 아래 Astro 기본값을 쓴다.
# WRITER_CONTENT_DIR=src/content/blog
# WRITER_SCHEMA=.astro/collections/blog.schema.json
# LLM Provider. claude-code(기본값, Claude 구독) 또는 anthropic-api(API 키, 사용량 과금).
# LLM_PROVIDER=claude-code
# 모델 ID. 비워 두면 Provider의 기본 모델을 쓴다.
# WRITER_MODEL=
